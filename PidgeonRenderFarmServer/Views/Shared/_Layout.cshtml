@using PidgeonRenderFarm.Server
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - PidgeonRenderFarmServer</title>
    @await PidgeonRenderFarm.Common.ASP.NET.StyleHelper.GetDefaultStylesAsync()
</head>
<body>
<header>
    <nav>
        <div>
            <a><b>PidgeonRenderFarm</b></a>
        </div>
        
        @if (!ServerKernel.RequiresConfiguration)
        {
            @await Html.DisplayNavbarDropdown("Project", new(){ { "New", "" }, {"Archive", ""} }, "")
            @await Html.DisplayNavbarDropdown("Setup", new(){ { "Configuration", "" }, {"Blender Installations", ""} })
            @await Html.DisplayNavbarDropdown("Help", new(){ { "Discord", "" }, {"YouTube", ""}, {"Donate", ""} })
        }
        
    </nav>
</header>

<main role="main">
    @RenderBody()
</main>

<footer style="margin-top: 48px">
    <div class="container">
        &copy; 2025 - PidgeonTools
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("scripts", required: false)
</body>
</html>