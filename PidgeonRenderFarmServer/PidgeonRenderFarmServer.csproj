<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PidgeonRenderFarm.Server</RootNamespace>
        <LangVersion>default</LangVersion>
        <Authors>PidgeonTools</Authors>
        <PackageProjectUrl>https://github.com/PidgeonTools/PidgeonRenderFarm</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/PidgeonTools/PidgeonRenderFarm/blob/main/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/PidgeonTools/PidgeonRenderFarm</RepositoryUrl>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\css\site.css" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PidgeonRenderFarmCommon\PidgeonRenderFarmCommon.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Managers\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.5" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="9.0.5" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

</Project>
